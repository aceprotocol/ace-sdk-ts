{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env.prod*)",
      "Read(**/*.pem)",
      "Read(**/*.p8)",
      "Read(**/*.key)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$(git status --porcelain -- '*.ts' '*.tsx')\" ] || npm run -s typecheck 1>&2 || exit 2",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
