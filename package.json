{
  "name": "@ace-protocol/sdk",
  "version": "0.2.0",
  "description": "ACE Protocol SDK \u2014 Agent Commerce Engine for agent-to-agent commerce messaging",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit && tsc --noEmit --target ES2022 --module NodeNext --strict --skipLibCheck examples/quickstart.ts",
    "prepublishOnly": "npm run lint && npm run test && npm run build"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "ace",
    "protocol",
    "agent",
    "commerce",
    "a2a",
    "cryptography",
    "e2e-encryption",
    "post-quantum",
    "x-wing",
    "ml-kem",
    "digital-signature"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pureace/sdk-ts.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@noble/curves": "^2.0.0",
    "@noble/hashes": "^2.0.0",
    "@noble/post-quantum": "^0.7.1",
    "bs58": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  },
  "license": "Apache-2.0"
}
